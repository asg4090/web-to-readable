include LICENSE README.md README.en.md CHANGELOG.md CONTRIBUTING.md SECURITY.md THIRD_PARTY_NOTICES.md PUBLISHING.md RELEASE_CHECKS.md
include plugin.json mcp.json requirements.txt
recursive-include src *.py *.js
recursive-include tests *.py
recursive-include examples *.json *.py
prune dist
prune build
prune .venv
global-exclude __pycache__ *.py[cod] .DS_Store
